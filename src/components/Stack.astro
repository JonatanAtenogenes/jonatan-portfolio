---
import { getLanguageFromUrl, useTranslation } from '@i18n/utils';
import { stackCategories, learning } from '@data/stack';
import StackCard from './StackCard.astro';

const lang = getLanguageFromUrl(Astro.url);
const t = useTranslation(lang);
const byKey = Object.fromEntries(stackCategories.map((c) => [c.key, c]));
---

<section
  id="stack"
  class="px-6 sm:px-8 max-w-4xl mx-auto py-16 sm:py-24 border-t border-line"
>
  <h2 class="font-serif text-2xl sm:text-3xl mb-10 sm:mb-14">
    {t('stack.label')}
  </h2>

  <div class="flex flex-col sm:flex-row gap-4">
    <div class="flex flex-col gap-4 sm:w-1/2">
      <StackCard title={t('stack.frontend')} items={byKey.frontend.items} />
      <StackCard title={t('stack.mobile')} items={byKey.mobile.items} />
      <StackCard title={t('stack.database')} items={byKey.database.items} />
    </div>

    <div class="flex flex-col gap-4 sm:w-1/2">
      <StackCard title={t('stack.backend')} items={byKey.backend.items} />
      <StackCard title={t('stack.bi')} items={byKey.bi.items} />
      <StackCard title={t('stack.devops')} items={byKey.devops.items} />
    </div>
  </div>

  <div class="mt-12">
    <h3 class="font-sans text-xs uppercase tracking-widest text-ink/40 mb-3">
      {t('stack.learning')}
    </h3>
    <p class="font-sans text-sm text-ink/60">
      {
        learning.map((item, i) => (
          <>
            {item}
            {i < learning.length - 1 && (
              <span class="text-accent2 mx-2">—</span>
            )}
          </>
        ))
      }
    </p>
  </div>
</section>
