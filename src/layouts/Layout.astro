---
import '@styles/global.css';
import LanguageToggle from '@components/LanguageToggle.astro';
import { getLanguageFromUrl } from '@i18n/utils';

const lang = getLanguageFromUrl(Astro.url);

const enPath = Astro.url.pathname.replace(/^\/es(\/|$)/, '/');
const esPath = enPath === '/' ? '/es/' : `/es${enPath}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/icon.webp" />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(enPath, Astro.site ?? Astro.url)}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(esPath, Astro.site ?? Astro.url)}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Jonatan Eslava</title>
  </head>
  <body>
    <div
      class="fixed top-4 right-4 sm:top-6 sm:right-8 z-50 bg-bg/80 backdrop-blur px-3 py-2 border border-line"
    >
      <LanguageToggle />
    </div>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
